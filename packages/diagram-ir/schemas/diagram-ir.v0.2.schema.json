{
  "$id": "https://github.com/DearKarl/hedgehog-master/schemas/diagram-ir.v0.2.schema.json",
  "additionalProperties": false,
  "type": "object",
  "required": ["irVersion", "id", "title", "kind", "direction", "nodes", "edges", "metadata"],
  "properties": {
    "irVersion": {
      "anyOf": [
        {
          "const": "0.1a",
          "type": "string"
        },
        {
          "const": "0.2",
          "type": "string"
        }
      ]
    },
    "id": {
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "kind": {
      "anyOf": [
        {
          "const": "dataflow",
          "type": "string"
        },
        {
          "const": "cycle",
          "type": "string"
        },
        {
          "const": "comparison",
          "type": "string"
        },
        {
          "const": "architecture",
          "type": "string"
        },
        {
          "const": "timeline",
          "type": "string"
        }
      ]
    },
    "direction": {
      "anyOf": [
        {
          "const": "left-to-right",
          "type": "string"
        },
        {
          "const": "top-to-bottom",
          "type": "string"
        },
        {
          "const": "clockwise",
          "type": "string"
        }
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": ["id", "label", "role"],
        "properties": {
          "id": {
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "label": {
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "anyOf": [
              {
                "const": "source",
                "type": "string"
              },
              {
                "const": "transform",
                "type": "string"
              },
              {
                "const": "model",
                "type": "string"
              },
              {
                "const": "metric",
                "type": "string"
              },
              {
                "const": "output",
                "type": "string"
              }
            ]
          },
          "group": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": ["id", "from", "to"],
        "properties": {
          "id": {
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "type": "string"
          },
          "from": {
            "minLength": 1,
            "type": "string"
          },
          "to": {
            "minLength": 1,
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "evidenceRef": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {}
      }
    }
  }
}
